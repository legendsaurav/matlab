
clc;
clear;
close all;

% Given digital plant at Ts = 1 s
z = tf('z', 1);
Gz = 0.32*(z + 0.62)/((z - 1)*(z - 0.15));

% Reconstruct continuous-time plant
Gs = d2c(Gz, 'zoh');

T_grid = 0.1:0.1:1.0;

figure;
hold on;
grid on;

colors = lines(length(T_grid));

for k = 1:length(T_grid)

    Ts = T_grid(k);
    Gd = c2d(Gs, Ts, 'zoh');

    % Compute root locus samples
    [K, poles] = rlocus(Gd);

    % Map discrete poles to the principal s-plane branch
    s_poles = log(poles) / Ts;

    % Plot each branch
    for branch = 1:size(s_poles, 1)
        plot(real(s_poles(branch,:)), ...
            imag(s_poles(branch,:)), ...
            'Color', colors(k,:), ...
            'LineWidth', 1.2);
    end

end

xlabel('Real Part (1/s)');
ylabel('Imaginary Part (rad/s)');
title('Mapped Root Loci for Different Sampling Times');

legend(compose('T_s = %.1f s', T_grid), ...
    'Location', 'eastoutside');
xline(0, '--k', 'Stability boundary');
